{
  "name": "root",
  "private": true,
  "author": "Jakub Freisler <jakub.freisler@frsource.org>",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --filter './packages/**' build",
    "lint": "eslint '**/*.ts' --ignore-pattern '**/*.d.ts' --ignore-pattern 'apps/**'",
    "fix": "pnpm lint --fix",
    "lint:ci": "pnpm lint --max-warnings 0",
    "format": "pnpm -r format",
    "format:ci": "pnpm -r --filter './packages/**' format:ci",
    "test": "pnpm -r test:integration:ci",
    "test:integration": "pnpm -r test:integration",
    "test:integration:watch": "pnpm -r test:integration:watch",
    "test:integration:coverage": "pnpm -r test:integration:coverage",
    "test:integration:ci": "pnpm -r test:integration:ci"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@frsource/eslint-config": "1.85.13",
    "eslint": "10.11.0",
    "globals": "17.12.0"
  }
}
