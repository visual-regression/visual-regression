{
  "name": "root",
  "private": true,
  "author": "Jakub Freisler <jakub.freisler@frsource.org>",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --filter './packages/**' build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "test": "pnpm -r test:integration:ci",
    "test:integration": "pnpm -r test:integration",
    "test:integration:watch": "pnpm -r test:integration:watch",
    "test:integration:coverage": "pnpm -r test:integration:coverage",
    "test:integration:ci": "pnpm -r test:integration:ci",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@frsource/eslint-config": "1.85.13",
    "@frsource/prettier-config": "^1.48.0",
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.70.0"
  }
}
