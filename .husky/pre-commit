# Git hooks run in a non-interactive shell where `nvm` is not loaded: load it
# so the hook uses the Node version from .nvmrc (skipped if nvm is not installed).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use
  nvm use >/dev/null || echo "husky: run 'nvm install' to get the Node version from .nvmrc" >&2
fi

pnpm exec lint-staged
